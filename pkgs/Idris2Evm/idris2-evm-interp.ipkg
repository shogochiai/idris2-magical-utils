package idris2-evm-interp

version = "0.3.0"

authors = "LazyEvm Team"

-- ROLE: the bytecode INTERPRETER. Split out of idris2-evm so it stops being
-- compiled into every consumer of the contract-authoring library that has no
-- use for it.
--
-- This split was attempted once and reverted the same day: the only consumer
-- that needs it, Idris2EvmCoverage, does `import public EVM.Interpreter`, so it
-- must `depends = idris2-evm-interp` — and that name could then only be added
-- to the untracked ~/code/pack.toml, which would have made the repo build here
-- and nowhere else. Owning package names in the tracked pack.toml (00d99e48)
-- is what unblocked it.
--
-- ⚠ RETIREMENT CANDIDATE, kept visible rather than assumed away. Two measured
-- facts: no ipkg here ever declared `main = Main`, so the interpreter's entry
-- point compiled as a module and never produced an executable; and bob reports
-- the live interpreter is a separate repo, shogochiai/idris2-evm. Deleting it
-- is a human decision, not an inference, so the split makes the redundancy
-- legible and leaves the choice open.
--
-- No `executable` on purpose: this package must not claim another command name
-- while the idris2-yul collision with shogochiai/idris2-yul is still open.
brief = "Idris2 EVM bytecode interpreter (retirement candidate: see shogochiai/idris2-evm)"

sourcedir = "src"

depends = base, contrib, idris2, idris2-evm

modules = EVM.Bytecode
        , EVM.Interpreter
        , EVM.WorldState
        , EVM.MultiInterpreter
        , Main
