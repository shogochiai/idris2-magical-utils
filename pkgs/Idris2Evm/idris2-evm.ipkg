package idris2-evm

version = 0.3.0

authors = "LazyEvm Team"

-- ROLE: the library a CONTRACT imports. Word/stack/memory/storage models,
-- opcode primitives, ABI. Nothing here knows about compilation or execution.
--
-- It used to declare the interpreter and the whole Yul codegen as well — the
-- same 26 modules as idris2-yul.ipkg, differing only by main/executable. That
-- is why its own brief read "interpreter, Yul codegen backend, FFI primitives,
-- and ABI": four roles behind one name.
--
-- Safe to shrink, measured first: every out-of-package importer
-- (Idris2EvmCoverage, Idris2Subcontract, Idris2TextDao) imports only
-- EVM.Primitives, EVM.Storage.Namespace and EVM.Word256 — all role-A modules.
-- The INTERPRETER (Bytecode/Interpreter/WorldState/MultiInterpreter/Main) is
-- still here, and that is a deliberate stop rather than an oversight. Splitting
-- it into idris2-evm-interp was written, built clean, and then REVERTED: the
-- dependent Idris2EvmCoverage does `import public EVM.Interpreter`, so it would
-- have to `depends = idris2-evm-interp` — and that name would have to be added
-- to ~/code/pack.toml, a machine-local file no repository owns. The package
-- would then build here and nowhere else until every machine hand-edits the
-- same file. That trades one fragility for a worse one, so the interpreter
-- split waits until package names are owned by the repo.
brief = "Idris2 EVM contract-authoring library + bytecode interpreter (interpreter pending its own package)"

sourcedir = "src"

depends = base, contrib, idris2

modules = EVM.Word256
        , EVM.Stack
        , EVM.Memory
        , EVM.Opcodes
        , EVM.Primitives
        , EVM.Storage.Model
        , EVM.Storage.Namespace
        , EVM.Storage.Storable
        , EVM.ABI.Types
        , EVM.ABI.JSON
        , EVM.Tests.AllTests
        , EVM.Bytecode
        , EVM.Interpreter
        , EVM.WorldState
        , EVM.MultiInterpreter
        , Main
